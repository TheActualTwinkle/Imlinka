<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Imlinka</PackageId>
    <Version>0.1.5</Version>
    <Authors>Fedor Moykin</Authors>
    <Description>.NET library for automatic trace spans creation using build-time IL weaving.</Description>
    <PackageTags>tracing;opentelemetry;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/TheActualTwinkle/Imlinka</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>logo.png</PackageIcon>
    <NoWarn>$(NoWarn);NU5100;CS1591</NoWarn>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tasks/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../.github/images/logo.png" Pack="true" PackagePath="/" Visible="false" />
    <None Include="buildTransitive/Imlinka.targets" Pack="true" PackagePath="buildTransitive/Imlinka.targets" />
  </ItemGroup>

  <Target Name="BuildImlinkaTasks" BeforeTargets="_GetPackageFiles;GenerateNuspec;Pack">
    <MSBuild
      Projects="../Imlinka.Tasks/Imlinka.Tasks.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <None Include="../Imlinka.Tasks/bin/$(Configuration)/netstandard2.0/*.dll" Pack="true" PackagePath="tasks/netstandard2.0/" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
